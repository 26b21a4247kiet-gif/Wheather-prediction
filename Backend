        "# ============================================================================\n",
        "# TEAM B6 - MARKOV CHAIN WEATHER PREDICTION\n",
        "# ============================================================================\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# -------------------- TEAM INFORMATION --------------------\n",
        "TEAM = \"B6\"\n",
        "PROJECT = \"Markov Chain: Weather Prediction\"\n",
        "MEMBERS = [\"Member 1\", \"Member 2\", \"Member 3\", \"Member 4\"]\n",
        "\n",
        "print(\"=\" * 70)\n",
        "print(f\"TEAM {TEAM} | {PROJECT}\")\n",
        "print(\"Applications: Weather Prediction | Population Dynamics | Queueing Theory\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "# -------------------- WEATHER STATES --------------------\n",
        "states = [\"Sunny\", \"Cloudy\", \"Rainy\"]\n",
        "\n",
        "# Transition Matrix\n",
        "# Rows = Current weather\n",
        "# Columns = Next weather\n",
        "P = np.array([\n",
        "    [0.6, 0.3, 0.1],   # Sunny\n",
        "    [0.4, 0.4, 0.2],   # Cloudy\n",
        "    [0.3, 0.3, 0.4]    # Rainy\n",
        "])\n",
        "\n",
        "print(\"\\nTransition Matrix P:\")\n",
        "print(P)\n",
        "\n",
        "# Check that every row sums to 1\n",
        "print(\"\\nRow sums:\", P.sum(axis=1))\n",
        "\n",
        "# -------------------- EIGENVALUE = 1 --------------------\n",
        "eigenvalues, eigenvectors = np.linalg.eig(P.T)\n",
        "\n",
        "index = np.argmin(np.abs(eigenvalues - 1))\n",
        "\n",
        "steady_state = np.real(eigenvectors[:, index])\n",
        "\n",
        "# Normalize steady state\n",
        "steady_state = steady_state / np.sum(steady_state)\n",
        "\n",
        "print(\"\\nEigenvalues:\")\n",
        "print(np.real(eigenvalues))\n",
        "\n",
        "print(\"\\nSteady-State Distribution (Eigenvalue = 1):\")\n",
        "for state, value in zip(states, steady_state):\n",
        "    print(f\"{state}: {value:.4f}\")\n",
        "\n",
        "# Verify steady state\n",
        "print(\"\\nSteady-State Verification (πP = π):\")\n",
        "print(np.round(steady_state @ P, 4))\n",
        "\n",
        "# -------------------- A^n CONVERGENCE --------------------\n",
        "days = 100\n",
        "\n",
        "# Initial distribution: Today = Sunny\n",
        "initial = np.array([1.0, 0.0, 0.0])\n",
        "\n",
        "distributions = []\n",
        "\n",
        "for n in range(days + 1):\n",
        "    distribution = initial @ np.linalg.matrix_power(P, n)\n",
        "    distributions.append(distribution)\n",
        "\n",
        "distributions = np.array(distributions)\n",
        "\n",
        "day100 = distributions[100]\n",
        "\n",
        "print(\"\\nWeather Distribution After 100 Days:\")\n",
        "for state, value in zip(states, day100):\n",
        "    print(f\"{state}: {value:.4f}\")\n",
        "\n",
        "# -------------------- DOES IT DEPEND ON TODAY'S WEATHER? --------------------\n",
        "print(\"\\nDoes the long-term distribution depend on today's weather?\")\n",
        "\n",
        "initial_conditions = {\n",
        "    \"Sunny\": np.array([1.0, 0.0, 0.0]),\n",
        "    \"Cloudy\": np.array([0.0, 1.0, 0.0]),\n",
        "    \"Rainy\": np.array([0.0, 0.0, 1.0])\n",
        "}\n",
        "\n",
        "for weather, initial_state in initial_conditions.items():\n",
        "\n",
        "    result = initial_state @ np.linalg.matrix_power(P, 100)\n",
        "\n",
        "    print(f\"{weather:7s} -> {np.round(result, 4)}\")\n",
        "\n",
        "print(\"\\nConclusion:\")\n",
        "print(\"After many days, the distribution approaches the same steady state\")\n",
        "print(\"regardless of today's weather.\")\n",
        "\n",
        "# -------------------- SENSITIVITY ANALYSIS --------------------\n",
        "# Change Sunny -> Cloudy probability\n",
        "# and observe how steady state changes.\n",
        "\n",
        "p_values = np.linspace(0.10, 0.50, 9)\n",
        "\n",
        "sensitivity = []\n",
        "\n",
        "for p_sc in p_values:\n",
        "\n",
        "    # Row sum = 1\n",
        "    P_test = np.array([\n",
        "        [0.9 - p_sc, p_sc, 0.1],\n",
        "        [0.4, 0.4, 0.2],\n",
        "        [0.3, 0.3, 0.4]\n",
        "    ])\n",
        "\n",
        "    # Eigenvalue = 1\n",
        "    vals, vecs = np.linalg.eig(P_test.T)\n",
        "\n",
        "    idx = np.argmin(np.abs(vals - 1))\n",
        "\n",
        "    ss = np.real(vecs[:, idx])\n",
        "\n",
        "    # Normalize\n",
        "    ss = ss / np.sum(ss)\n",
        "\n",
        "    sensitivity.append(ss)\n",
        "\n",
        "sensitivity = np.array(sensitivity)\n",
        "\n",
        "# -------------------- VISUALIZATION 1 --------------------\n",
        "# FIX: Create 101 x-axis values for Day 0 to Day 100\n",
        "\n",
        "day_range = np.arange(days + 1)\n",
        "\n",
        "plt.figure(figsize=(11, 6))\n",
        "\n",
        "plt.plot(\n",
        "    day_range,\n",
        "    distributions[:, 0],\n",
        "    label=\"Sunny\",\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    day_range,\n",
        "    distributions[:, 1],\n",
        "    label=\"Cloudy\",\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    day_range,\n",
        "    distributions[:, 2],\n",
        "    label=\"Rainy\",\n",
        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Team B6 - Weather Distribution Over 100 Days\",\n",
        "    fontsize=14,\n",
        "    fontweight=\"bold\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Day\")\n",
        "plt.ylabel(\"Probability\")\n",
        "\n",
        "plt.legend(title=\"Weather State\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# -------------------- VISUALIZATION 2 --------------------\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "plt.plot(\n",
        "    p_values,\n",
        "    sensitivity[:, 0],\n",
        "    marker=\"o\",\n",
        "    label=\"Sunny\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    p_values,\n",
        "    sensitivity[:, 1],\n",
        "    marker=\"s\",\n",
        "    label=\"Cloudy\"\n",
        ")\n",
        "\n",
        "plt.plot(\n",
        "    p_values,\n",
        "    sensitivity[:, 2],\n",
        "    marker=\"^\",\n",
        "    label=\"Rainy\"\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    \"Sensitivity Analysis: Sunny → Cloudy Probability\",\n",
        "    fontsize=14,\n",
        "    fontweight=\"bold\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Sunny → Cloudy Transition Probability\")\n",
        "plt.ylabel(\"Steady-State Probability\")\n",
        "\n",
        "plt.legend(title=\"Weather State\")\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# -------------------- FINAL SUMMARY --------------------\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"PROJECT SUMMARY\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\"✓ Transition Matrix constructed\")\n",
        "print(\"✓ Eigenvalue = 1 method used\")\n",
        "print(\"✓ Steady-state distribution calculated\")\n",
        "print(\"✓ A^n convergence tested for 100 days\")\n",
        "print(\"✓ Today's weather independence tested\")\n",
        "print(\"✓ Parameter sensitivity analysis added\")\n",
        "print(\"✓ Improved visualizations added\")\n",
        "print(\"=\" * 70)"
